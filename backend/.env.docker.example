# Celery container 专用环境(docker-compose env_file 加载)
# uvicorn (host 进程) 用 backend/.env;celery (container 内) 用本文件
# 关键差异:容器内走 docker DNS / 容器内端口,而 uvicorn 走 host 端口

# Redis (celery 容器内,走 docker DNS alias)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Storage backend (2026-09-01) — 让 celery 也走 MinIO,不再用 host file_path
# S3_ENDPOINT 用 docker network 内 alias + 容器端口 9000(不是 host 29000)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://lumen-platform-minio:9000
S3_BUCKET=lumen-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY=3600

# Database (celery 容器内,走 docker DNS alias mysql)
DATABASE_URL=mysql+pymysql://root:rootpassword@mysql:3306/ai_platform

# Ollama (celery 容器内,走 docker DNS alias ollama)
OLLAMA_API_BASE=http://ollama:11434

# Elasticsearch (celery 容器内,走 docker DNS alias elasticsearch)
ES_HOST=elasticsearch
ES_PORT=9200
